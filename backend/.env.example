# Dirección donde escucha el servidor gRPC (modo local con procesos separados)
GRPC_BIND_ADDRESS=127.0.0.1:50051
# Dirección a la que se conecta el gateway
GRPC_SERVER_ADDRESS=127.0.0.1:50051
# Orígenes permitidos por CORS, separados por coma y sin "/" al final.
# En producción agrega el dominio de Vercel, por ejemplo: http://localhost:3000,https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:3000
# true = el gateway inicia el servidor gRPC dentro del mismo proceso (despliegue en Render)
EMBED_GRPC_SERVER=false
